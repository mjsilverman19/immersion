# Optional base-map overrides. Leave unset to use the keyless defaults:
# OpenFreeMap vector tiles + self-hosted serif glyphs, restyled into the
# cream/ink atlas surface in src/lib/mapStyle.ts.
#
# VITE_TILE_URL   — TileJSON URL for an OpenMapTiles-schema vector source.
# VITE_GLYPHS_URL — glyph pbf template ({fontstack}/{range}.pbf).
VITE_TILE_URL=
VITE_GLYPHS_URL=

# Used by the supabase/functions/google-places edge function (Task 3).
# Not read by the client.
# GOOGLE_PLACES_API_KEY=
